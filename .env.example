# Base MongoDB (Atlas ou locale)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/restaurant

# Secret des sessions (générer avec: npx auth secret)
AUTH_SECRET=change-me
NEXTAUTH_SECRET=change-me

# Super-administrateur de la plateforme (valide les demandes de restaurants)
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=change-me

# Optionnel : reconstruction 3D automatique à partir des photos du scan (https://www.meshy.ai)
MESHY_API_KEY=
# MESHY_AI_MODEL=latest

# Optionnel : les anciens QR codes "/?table=N" redirigent vers ce restaurant
DEFAULT_RESTAURANT_SLUG=
