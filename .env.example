# Base MongoDB (Atlas ou locale)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/restaurant

# Secret des sessions (générer avec: npx auth secret)
AUTH_SECRET=change-me
NEXTAUTH_SECRET=change-me

# Super-administrateur de la plateforme (valide les demandes, gère les abonnements)
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=change-me

# Adresse publique du site (liens envoyés aux gérants). Sinon déduite de la requête.
APP_URL=https://mon-site.vercel.app

# Optionnel : e-mails automatiques (https://resend.com) — validation, paiements, nouvelles demandes
RESEND_API_KEY=
MAIL_FROM=Menu3D <contact@mon-domaine.com>

# Optionnel : scan 3D automatique depuis les photos (offre Premium)
#  - photogrammétrie réelle, 20 à 300 photos, détourage automatique (https://www.kiriengine.app/api)
KIRI_API_KEY=
#  - reconstruction par IA à partir de 4 photos (https://www.meshy.ai), utilisée si KIRI n'est pas configuré
MESHY_API_KEY=
# MESHY_AI_MODEL=latest

# Optionnel : les anciens QR codes "/?table=N" redirigent vers ce restaurant
DEFAULT_RESTAURANT_SLUG=
